NODE_ENV=production
PORT=5000
MONGODB_URI=mongodb+srv://YOUR_DATABASE_CONNECTION
ACCESS_TOKEN_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
REFRESH_TOKEN_SECRET=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_SECRET
ACCESS_TOKEN_VALIDITY=15m
REFRESH_TOKEN_VALIDITY=7d
CORS_ORIGIN=https://ownersuite.web.app,https://ornionshop.web.app

CLOUD_STORAGE_ACCOUNT_ID=YOUR_R2_ACCOUNT_ID
CLOUD_STORAGE_ACCESS_KEY=YOUR_R2_ACCESS_KEY
CLOUD_STORAGE_SECRET_KEY=YOUR_R2_SECRET_KEY
CLOUD_STORAGE_BUCKET=YOUR_R2_BUCKET
CLOUD_STORAGE_PUBLIC_URL=https://YOUR_PUBLIC_IMAGE_DOMAIN
